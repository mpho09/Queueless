    "client/src/__tests__/OfflineBanner.test.jsx",
    "client/src/__tests__/QueueBadge.test.jsx",
    "client/src/components/domain/CheapestPill.jsx",
    "client/src/components/domain/MissingItemsPill.jsx",
    "client/src/components/domain/PriceAgeBadge.jsx",
    "client/src/components/domain/QueueBadge.jsx",
    "client/src/components/domain/StockBadge.jsx",
    "client/src/components/domain/StoreComparisonCard.jsx",
    "client/src/components/feedback/EmptyState.jsx",
    "client/src/components/feedback/OfflineBanner.jsx",
    "client/src/components/feedback/Skeleton.jsx",
    "client/src/components/feedback/Toast.jsx",
    "client/src/components/layout/AppShell.jsx",
    "client/src/components/layout/BottomTabBar.jsx",
    "client/src/components/layout/DesktopNav.jsx",
    "client/src/components/layout/Footer.jsx",
    "client/src/components/layout/GlobalHeader.jsx",
    "client/src/components/layout/navItems.js",
    "client/src/components/ui/QuantityStepper.jsx",
    "client/src/components/ui/SearchField.jsx",
    "client/src/components/ui/Select.jsx",
    "client/src/hooks/useBasket.js",
    "client/src/hooks/useBasketCount.js",
    "client/src/hooks/useOnline.js",
