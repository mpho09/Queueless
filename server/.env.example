PORT=3001

# Hosted Supabase project (Dashboard → Project Settings → API). Ask the Tech Lead privately.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret — never commit the real value or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email through Resend (price-drop alerts, #20). Leave the key empty in development: emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=Queueless <alerts@your-verified-domain.co.za>
