{
  "name": "queueless",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w client",
    "db:link": "supabase link",
    "db:migration": "supabase migration new",
    "db:check": "supabase db push --remote --dry-run",
    "db:push": "supabase db push --remote",
    "db:seed": "supabase db push --remote --include-seed",
    "db:test": "supabase test db --remote",
    "db:reset:hosted": "supabase db reset --remote"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "supabase": "^3.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
